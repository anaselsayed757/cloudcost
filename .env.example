# ── REQUIRED ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING

# ── DATABASE ──────────────────────────────────────────────────────────────────
POSTGRES_USER=clouduser
POSTGRES_PASSWORD=cloudpass
POSTGRES_DB=cloudcost

# ── CORS & URLs ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000
# URL shown in alert emails so recipients can click through to the dashboard
DASHBOARD_URL=http://localhost:3000

# ── EMAIL (leave blank to use MailHog in dev) ─────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Production Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_app_password   # use a Gmail App Password, not your account password

# ── BOOTSTRAP ─────────────────────────────────────────────────────────────────
# Password set when /auth/setup-admin is called for the first time
ADMIN_DEFAULT_PASSWORD=cloudcost2024

# ── GRAFANA ───────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_PASSWORD=cloudcost2024
